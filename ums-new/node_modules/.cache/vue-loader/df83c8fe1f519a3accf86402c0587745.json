{"remainingRequest":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/vue-loader/lib/index.js??vue-loader-options!/home/jana/Projects/Vue/UMS-New/ums-new/src/components/PopupComponents/DeleteTopicPopup.vue?vue&type=script&lang=js&","dependencies":[{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/src/components/PopupComponents/DeleteTopicPopup.vue","mtime":1631024272277},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/babel-loader/lib/index.js","mtime":315532800000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["DeleteTopicPopup.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;AAqBA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;;AAGA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA","file":"DeleteTopicPopup.vue","sourceRoot":"src/components/PopupComponents","sourcesContent":["<template>\n  <v-dialog\n    v-model=\"deleteDialog\"\n    persistent\n    max-width=\"500px\"\n    :retain-focus=\"false\"\n  >\n    <v-card>\n      <v-toolbar color=\"error\" dark>Alert !!!</v-toolbar>\n      <v-card-text>\n        <div class=\"text-h4 text-center py-12\">Are You Sure ?</div>\n      </v-card-text>\n      <v-card-actions class=\"justify-end\">\n        <v-btn text :loading=\"loading\" @click.prevent=\"confirmDelete\">Yes</v-btn>\n        <v-btn text @click=\"closeDelete\">Close</v-btn>\n      </v-card-actions>\n    </v-card>\n  </v-dialog>\n</template>\n\n<script>\nimport userService from \"../../Services/user.service\";\nexport default {\n  data() {\n    return {\n      loading:false\n    };\n  },\n\n  props: {\n    deleteDialog: Boolean,\n    itemId: String,\n   \n   \n  },\n  methods: {\n    async confirmDelete() {\n      \n      this.loading=true;\n      await userService.deleteTopic(this.itemId).then((response) => {\n        if (response.data.success == true) {\n          this.loading=false;\n          this.$emit('successSnackbar',response.data.message)\n        }\n        else{\n          this.$emit('errorSnackbar',response.data.message)\n        }\n      });\n      this.deleteDialog = false;\n      this.$emit(\"deleteDialog\", false);\n      //for update the table\n      this.$emit(\"updateTable\");\n      \n    },\n\n    closeDelete() {\n      this.itemId = \"\";\n      this.deleteDialog = false;\n      this.$emit(\"deleteDialog\", false);\n    },\n  },\n};\n</script>\n\n<style>\n</style>"]}]}
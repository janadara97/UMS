   <v-card-title class=\"v-card-title\">\n                <v-row class=\"mx-auto pt-0\" dense>\n                  <v-col cols=\"12\">\n                    <div class=\"subhedding text-center white--text\">\n                      {{ stat.user }}\n                    </div>\n                  </v-col>\n                  <v-col cols=\"12\">\n                    <v-avatar class=\"avatar1\" color=\"white\" size=\"36\">\n                      <div class=\"black--text text-center\">\n                        {{ stat.number }}\n                      </div>\n                    </v-avatar>\n                  </v-col>\n                </v-row>\n              </v-card-title>\n            </v-col>\n            \n          </v-row>\n        </v-card>\n      </v-hover>\n    </v-col>\n  </v-row>\n</template>\n\n<script>\nexport default {\n    data(){\n        return{\n             stats: [\n        {\n          user: \"Students\",\n          number: \"59\",\n          avatar: require(\"../../assets/student.png\"),\n          colors: \"#EC407A\",\n        },\n        {\n          user: \"Lecturers\",\n          number: \"59\",\n          avatar: require(\"../../assets/presentation.png\"),\n          colors: \"#26C6DA\",\n        },\n        {\n          user: \"Modules\",\n          number: \"22\",\n          avatar: require(\"../../assets/online-course.png\"),\n          colors: \"#FFA726\",\n        },\n        {\n          user: \"Topics\",\n          number: \"89\",\n          avatar: require(\"../../assets/checklist.png\"),\n          colors: \"#E040FB\",\n        },\n      ],\n        }\n    }\n};\n</script>\n\n<style>\n.avatar {\n  margin-top: -55px;\n  text-align: center;\n}\n.avatar1 {\n  margin: 0 87px;\n  text-align: center;\n}\n.v-card-title {\n  margin-top: -30px;\n}\n.v-card-action {\n  margin-top: -35px;\n}\n.backgroundcolor {\n  background-color: lightblue;\n}\n.progress-bar-div {\n  height: 30%;\n  background: red;\n}\n</style>"]}]}
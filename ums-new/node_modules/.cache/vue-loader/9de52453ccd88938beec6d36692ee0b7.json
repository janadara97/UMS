\n        </v-row>\n      </v-container>\n    </v-card>\n  </v-col>\n</template>\n\n<script>\nexport default {\n  props:{\n    progress:Array\n  },\n   \n  data() {\n    return {\n    \n    };\n  },\n  methods: {\n    setProgressBarColours(value) {\n      if (value >= 0 && value <= 25) {\n        return \"red\";\n      } else if (value > 25 && value <= 50) {\n        return \"yellow\";\n      } else if (value > 50 && value <= 75) {\n        return \"blue\";\n      } else if (value > 75 && value <= 100) {\n        return \"green\";\n      }\n    },\n  },\n};\n</script>\n\n<style>\n</style>"]}]}
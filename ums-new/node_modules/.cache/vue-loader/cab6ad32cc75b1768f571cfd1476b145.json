{"remainingRequest":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/vue-loader/lib/index.js??vue-loader-options!/home/jana/Projects/Vue/UMS-New/ums-new/src/components/Models/spark.vue?vue&type=script&lang=js&","dependencies":[{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/src/components/Models/spark.vue","mtime":1629990096982},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/babel-loader/lib/index.js","mtime":315532800000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["spark.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAsDA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;;AAEA;;AAEA;AACA;AACA;AACA","file":"spark.vue","sourceRoot":"src/components/Models","sourcesContent":["<template>\n  <v-card\n    class=\"mx-auto\"\n    color=\"grey lighten-4\"\n    max-width=\"600\"\n  >\n    <v-card-title>\n      <v-icon\n        :color=\"checking ? 'red lighten-2' : 'indigo'\"\n        class=\"mr-12\"\n        size=\"64\"\n        @click=\"takePulse\"\n      >\n        mdi-heart-pulse\n      </v-icon>\n      <v-row align=\"start\">\n        <div class=\"text-caption grey--text text-uppercase\">\n          Heart rate\n        </div>\n        <div>\n          <span\n            class=\"text-h3 font-weight-black\"\n            v-text=\"avg || '—'\"\n          ></span>\n          <strong v-if=\"avg\">BPM</strong>\n        </div>\n      </v-row>\n\n      <v-spacer></v-spacer>\n\n      <v-btn\n        icon\n        class=\"align-self-start\"\n        size=\"28\"\n      >\n        <v-icon>mdi-arrow-right-thick</v-icon>\n      </v-btn>\n    </v-card-title>\n\n    <v-sheet color=\"transparent\">\n      <v-sparkline\n        :key=\"String(avg)\"\n        :smooth=\"16\"\n        :gradient=\"['#f72047', '#ffd200', '#1feaea']\"\n        :line-width=\"3\"\n        :value=\"heartbeats\"\n        auto-draw\n        stroke-linecap=\"round\"\n      ></v-sparkline>\n    </v-sheet>\n  </v-card>\n</template>\n\n<script>\n const exhale = ms =>\n    new Promise(resolve => setTimeout(resolve, ms))\n\n  export default {\n    data: () => ({\n      checking: false,\n      heartbeats: [],\n    }),\n\n    computed: {\n      avg () {\n        const sum = this.heartbeats.reduce((acc, cur) => acc + cur, 0)\n        const length = this.heartbeats.length\n\n        if (!sum && !length) return 0\n\n        return Math.ceil(sum / length)\n      },\n    },\n\n    created () {\n      this.takePulse(false)\n    },\n\n    methods: {\n      heartbeat () {\n        return Math.ceil(Math.random() * (120 - 80) + 80)\n      },\n      async takePulse (inhale = true) {\n        this.checking = true\n\n        inhale && await exhale(1000)\n\n        this.heartbeats = Array.from({ length: 20 }, this.heartbeat)\n\n        this.checking = false\n      },\n    },\n  }\n</script>\n\n<style>\n\n</style>"]}]}
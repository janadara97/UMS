or=\"blue darken-1\"\n            text\n            @click=\"dialog = false\"\n          >\n            Close\n          </v-btn>\n          <v-btn\n            color=\"blue darken-1\"\n            text\n            @click=\"dialog = false\"\n          >\n            Save\n          </v-btn>\n        </v-card-actions>\n      </v-card>\n    </v-dialog>\n  </v-row>\n</template>\n\n<script>\nexport default {\n    data: () => ({\n      dialog: false,\n    }),\n  }\n</script>\n\n<style>\n\n</style>"]}]}
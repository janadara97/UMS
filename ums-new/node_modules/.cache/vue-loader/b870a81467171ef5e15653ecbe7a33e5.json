{"remainingRequest":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/vue-loader/lib/index.js??vue-loader-options!/home/jana/Projects/Vue/UMS-New/ums-new/src/components/Users/Admin/Admin.vue?vue&type=script&lang=js&","dependencies":[{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/src/components/Users/Admin/Admin.vue","mtime":1629711412712},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/babel-loader/lib/index.js","mtime":315532800000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Admin.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAiIA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"Admin.vue","sourceRoot":"src/components/Users/Admin","sourcesContent":["<template>\n  <div class=\"dashboard mt-5\">\n    \n    <v-container class=\"mx-10\" fluid>\n      <v-layout row class=\"mb-10 mx-1 pa-3\">\n        <AddUserPopup />\n      </v-layout>\n\n      <v-data-table\n        :headers=\"headers\"\n        :items=\"users\"\n        items-per-page=10\n        class=\"elevation-1\"\n      >\n        <template v-slot:[`item.Actions`]=\"{ item }\">\n          <v-layout row>\n            <v-flex md5>\n              <v-col>\n                <v-dialog\n                  v-model=\"dialog\"\n                  persistent\n                  max-width=\"600px\"\n                  :retain-focus=\"false\"\n                >\n                  <template v-slot:activator=\"{ on, attrs }\">\n                    <v-btn\n                      rounded\n                      color=\"#1C2842\"\n                      class=\"white--text\"\n                      v-bind=\"attrs\"\n                      v-on=\"on\"\n                      @click=\"editItem(item)\"\n                    >\n                      Edit\n                    </v-btn>\n                  </template>\n                  <v-card>\n                    <v-card-title>\n                      <span class=\"text-h5\">User Profile</span>\n                    </v-card-title>\n                    <v-card-text>\n                      <v-container>\n                        <v-row>\n                          <v-col cols=\"12\">\n                            <v-text-field\n                              label=\"Name*\"\n                              required\n                              v-model=\"editedItem.Name\"\n                              :rules=\"[required('Name'),minLength('Name',5),maxLength('Name',50)]\"\n                            ></v-text-field>\n                          </v-col>\n                          <v-col cols=\"12\">\n                            <v-text-field\n                              label=\"User Name*\"\n                              required\n                              v-model=\"editedItem.UserName\"\n                              :rules=\"[required('UserName'),minLength('UserName',5),maxLength('UserName',50)]\"\n                            ></v-text-field>\n                          </v-col>\n\n                          <v-col cols=\"12\" sm=\"6\">\n                            <v-select\n                              :items=\"['Admin', 'Lecturer', 'Student']\"\n                              label=\"Role\"\n                              required\n                              :rules=\"[required('Role')]\"\n                              v-model=\"editedItem.Role\"\n                            ></v-select>\n                          </v-col>\n                          <v-col cols=\"12\" sm=\"6\" md=\"12\">\n                            <v-combobox\n                              v-model=\"editedItem.Authorities\"\n                              :items=\"users.Authorities\"\n                              clearable\n                              label=\"Select Authorities\"\n                              multiple\n                              solo\n                              :rules=\"[required('Authorities')]\"\n                            >\n                              <template\n                                v-slot:selection=\"{\n                                  attrs,\n                                  item,\n                                  select,\n                                  selected,\n                                }\"\n                              >\n                                <v-chip\n                                  v-bind=\"attrs\"\n                                  :input-value=\"selected\"\n                                  close\n                                  @click=\"select\"\n                                  @click:close=\"remove(item)\"\n                                >\n                                  <strong>{{ item }}</strong\n                                  >&nbsp;\n                                </v-chip>\n                              </template>\n                            </v-combobox>\n                          </v-col>\n                        </v-row>\n                      </v-container>\n                      <small>*indicates required field</small>\n                    </v-card-text>\n                    <v-card-actions>\n                      <v-spacer></v-spacer>\n                      <v-btn color=\"blue darken-1\" text @click=\"close\">\n                        Close\n                      </v-btn>\n                      <v-btn color=\"blue darken-1\" text @click=\"save\">\n                        Save\n                      </v-btn>\n                    </v-card-actions>\n                  </v-card>\n                </v-dialog>\n              </v-col>\n            </v-flex>\n            <v-flex md2>\n              <delete-confirm-popup />\n            </v-flex>\n          </v-layout>\n        </template>\n      </v-data-table>\n      <v-divider></v-divider>\n    </v-container>\n  </div>\n</template>\n\n<script>\nimport AddUserPopup from \"../../PopupComponents/AddUserPopup.vue\";\n//import EditUserPopup from \"../../PopupComponents/EditUserPopup.vue\";\nimport DeleteConfirmPopup from \"../../PopupComponents/DeleteConfirmPopup.vue\";\nexport default {\n  components: {\n    AddUserPopup,\n    DeleteConfirmPopup,\n  },\n  data() {\n    return {\n      dialog: false,\n      dialogDelete: false,\n      editedIndex: -1,\n\n      editedItem: {\n        UserName: \"\",\n        Role: \"\",\n        Authorities: [],\n      },\n      defaultItem: {\n        UserName: \"\",\n        Role: \"\",\n        Authorities: [],\n      },\n      users: [],\n      headers: [\n        {\n          text: \"User Name\",\n          align: \"start\",\n          sortable: \"false\",\n          value: \"UserName\",\n        },\n        { text: \"Role\", value: \"Role\" },\n        { text: \"Authorities\", value: \"Authorities\" },\n        { text: \"Actions\", value: \"Actions\" },\n      ],\n       required(property) {\n      return (v) => (v && v.length > 0) || `You Must Input a ${property}`;\n    },\n    minLength(property, minLength) {\n      return (v) =>\n        v.length >= minLength ||\n        `${property} must be at least ${minLength} characters`;\n    },\n    maxLength(property, maxLength) {\n      return (v) =>\n        v.length <= maxLength ||\n        `${property} must be at least ${maxLength} characters`;\n    },\n    };\n  },\n  created() {\n    this.userInitilize();\n  },\n  watch: {\n    dialog(val) {\n      val || this.close();\n    },\n    dialogDelete(val) {\n      val || this.closeDelete();\n    },\n  },\n  methods: {\n    userInitilize() {\n      this.users = [\n        {\n          UserName: \"janadara97\",\n          Role: \"Admin\",\n          Authorities: [\n            \"Read_User_Data\",\n            \"Write_User_Data\",\n            \"Delete_User_Data\",\n            \"Read_Lecturer_Data\",\n            \"Write_Lecturer_Data\",\n            \"Delete_Lecturer_Data\",\n            \"Read_Student_Data\",\n            \"Write_Student_Data\",\n            \"Delete_Student_Data\",\n          ],\n        },\n        {\n          UserName: \"kasun97\",\n          Role: \"Lecturer\",\n          Authorities: [\n            \"Read_Lecturer_Data\",\n            \"Write_Lecturer_Data\",\n            \"Delete_Lecturer_Data\",\n          ],\n        },\n        {\n          UserName: \"chathura97\",\n          Role: \"Student\",\n          Authorities: [\n            \"Read_Student_Data\",\n            \"Write_Student_Data\",\n            \"Delete_Student_Data\",\n          ],\n        },\n        {\n          UserName: \"kavinda97\",\n          Role: \"Lecturer\",\n          Authorities: [\n            \"Read_Lecturer_Data\",\n            \"Write_Lecturer_Data\",\n            \"Delete_Lecturer_Data\",\n          ],\n        },\n        {\n          UserName: \"mahinsa97\",\n          Role: \"Admin\",\n          Authorities: [\n            \"Read_User_Data\",\n            \"Write_User_Data\",\n            \"Delete_User_Data\",\n            \"Read_Lecturer_Data\",\n            \"Write_Lecturer_Data\",\n            \"Delete_Lecturer_Data\",\n            \"Read_Student_Data\",\n            \"Write_Student_Data\",\n            \"Delete_Student_Data\",\n          ],\n        },\n      ];\n    },\n    editItem(item) {\n      this.editedIndex = this.users.indexOf(item);\n\n      this.editedItem = Object.assign({}, item);\n\n      this.dialog = true;\n    },\n    save() {\n      if (this.editedIndex > -1) {\n        Object.assign(this.desserts[this.editedIndex], this.editedItem);\n      } else {\n        this.desserts.push(this.editedItem);\n      }\n      this.close();\n    },\n    close() {\n      this.dialog = false;\n      this.$nextTick(() => {\n        this.editedItem = Object.assign({}, this.defaultItem);\n\n        this.editedIndex = -1;\n      });\n    },\n  },\n};\n</script>\n\n<style>\n</style>"]}]}
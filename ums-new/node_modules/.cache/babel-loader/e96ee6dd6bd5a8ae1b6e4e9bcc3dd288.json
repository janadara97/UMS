\n\n    headers: [\n      { text: \"Topic ID\", align: \"start\", sortable: \"false\", value: \"Id\" },\n      { text: \"Topic Name\", value: \"Name\" },\n      { text: \"Topic Description\", value: \"Description\" },\n      { text: \"Actions\", value: \"Actions\" },\n    ],\n\n    topics: [],\n\n   \n\n    required(property) {\n      return (v) => (v && v.length > 0) || `You Must Input a ${property}`;\n    },\n    minLength(property, minLength) {\n      return (v) =>\n        v.length >= minLength ||\n        `${property} must be at least ${minLength} characters`;\n    },\n    maxLength(property, maxLength) {\n      return (v) =>\n        v.length <= maxLength ||\n        `${property} must be at least ${maxLength} characters`;\n    },\n  }),\n\n  created() {\n    this.topicinitilize();\n  },\n  components: {\n    Popup,\n    // EditTopicPopUps,\n    DeleteConfirmPopup,\n    EditTopicPopups,\n    //NavigationDrawer,\n  },\n  methods: {\n    topicinitilize() {\n      this.topics = [\n        {\n          Id: \"1\",\n          Name: \"Fundamentals Of Programming\",\n          Description:\n            \"FOP topic is a topic which cannnnnnnnnnnnnnnnnnn ..... \",\n        },\n        {\n          Id: \"2\",\n          Name: \"Fundamentals Of Programming\",\n          Description: \"FOP topic is a topic which can ..... \",\n        },\n        {\n          Id: \"3\",\n          Name: \"Fundamentals Of Programming\",\n          Description: \"FOP topic is a topic which can ..... \",\n        },\n        {\n          Id: \"4\",\n          Name: \"Fundamentals Of Programming\",\n          Description: \"FOP topic is a topic which can ..... \",\n        },\n        {\n          Id: \"5\",\n          Name: \"Fundamentals Of Programming\",\n          Description: \"FOP topic is a topic which can ..... \",\n        },\n      ];\n    },\n  },\n};\n</script>\n\n<style>\n</style>"],"sourceRoot":"src/components/Views"}]}
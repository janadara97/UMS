AAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,uBAGA,WAAA,CAAA,WAAA,CAAA,KAAA,CAAA,IAAA,EAAA,IAAA,CAAA,UAAA,QAAA,EAAA;AACA,sBAAA,QAAA,CAAA,IAAA,CAAA,OAAA,IAAA,IAAA,EAAA;AACA,oBAAA,KAAA,CAAA,OAAA,GAAA,KAAA;;AACA,oBAAA,KAAA,CAAA,KAAA,CAAA,iBAAA,EAAA,QAAA,CAAA,IAAA,CAAA,OAAA;AACA,mBAHA,MAIA;AACA,oBAAA,KAAA,CAAA,KAAA,CAAA,eAAA,EAAA,QAAA,CAAA,IAAA,CAAA,OAAA;AACA;AACA,iBARA,CAHA;;AAAA;AAYA,gBAAA,KAAA,CAAA,IAAA,GAAA,EAAA;AACA,gBAAA,KAAA,CAAA,UAAA,GAAA,KAAA;;AACA,gBAAA,KAAA,CAAA,KAAA,CAAA,cAAA,EAAA,KAAA;;AACA,gBAAA,KAAA,CAAA,KAAA,CAAA,cAAA;;AAfA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAgBA,KAlBA;AAmBA,IAAA,QAnBA,oBAmBA,IAnBA,EAmBA;AACA,WAAA,WAAA,GAAA,KAAA,MAAA,CAAA,OAAA,CAAA,IAAA,CAAA;AAEA,WAAA,UAAA,GAAA,MAAA,CAAA,MAAA,CAAA,EAAA,EAAA,IAAA,CAAA;AAEA,WAAA,MAAA,GAAA,IAAA;AACA,KAzBA;AA0BA,IAAA,IA1BA,kBA0BA;AACA,UAAA,KAAA,WAAA,GAAA,CAAA,CAAA,EAAA;AACA,QAAA,MAAA,CAAA,MAAA,CAAA,KAAA,QAAA,CAAA,KAAA,WAAA,CAAA,EAAA,KAAA,UAAA;AACA,OAFA,MAEA;AACA,aAAA,QAAA,CAAA,IAAA,CAAA,KAAA,UAAA;AACA;;AACA,WAAA,KAAA;AACA,KAjCA;AAkCA,IAAA,KAlCA,mBAkCA;AAAA;;AACA,WAAA,UAAA,GAAA,KAAA;AACA,WAAA,SAAA,CAAA,YAAA;AACA,QAAA,MAAA,CAAA,IAAA,GAAA,EAAA;;AACA,QAAA,MAAA,CAAA,KAAA,CAAA,cAAA,EAAA,KAAA;AACA,OAHA;AAIA;AAxCA,GAzBA;AAqEA,EAAA,KAAA,EAAA;AACA,IAAA,UAAA,EAAA,OADA;AAEA,IAAA,IAAA,EAAA;AAFA,GArEA;AAyEA,EAAA,KAAA,EAAA;AACA,IAAA,MADA,kBACA,GADA,EACA;AACA,MAAA,GAAA,IAAA,KAAA,KAAA,EAAA;AACA,KAHA;AAIA,IAAA,YAJA,wBAIA,GAJA,EAIA;AACA,MAAA,GAAA,IAAA,KAAA,WAAA,EAAA;AACA;AANA;AAzEA,CAAA","sourcesContent":["<template>\n  <v-col>\n    <v-dialog\n      v-model=\"editDialog\"\n      persistent\n      max-width=\"500px\"\n      :retain-focus=\"false\"\n    >\n      <v-card>\n        <v-layout row>\n          <v-flex class=\"primary white--text text-center\">\n            <v-card-title>\n              <span class=\"text-h5 pa-5\">Edit Topic</span>\n            </v-card-title>\n          </v-flex>\n        </v-layout>\n\n        <v-card-text>\n          <v-container>\n            <v-row>\n              <v-col cols=\"12\">\n                <v-text-field\n                  label=\"Topic ID*\"\n                  v-model=\"item.tId\"\n                  disabled\n                ></v-text-field>\n              </v-col>\n              <v-col cols=\"12\">\n                <v-text-field\n                  label=\"Topic Name*\"\n                  v-model=\"item.tName\"\n                  :rules=\"[\n                   \n                    minLength('Name', 5),\n                    maxLength('Name', 50),\n                  ]\"\n                ></v-text-field>\n              </v-col>\n              <v-col cols=\"12\">\n                <v-text-field\n                  label=\"Topic Description*\"\n                  v-model=\"item.tDes\"\n                  :rules=\"[\n                    \n                    minLength('Description', 20),\n                    maxLength('Description', 200),\n                  ]\"\n                ></v-text-field>\n              </v-col>\n            </v-row>\n          </v-container>\n          <small>*indicates required field</small>\n        </v-card-text>\n        <v-card-actions>\n          <v-spacer></v-spacer>\n          <v-btn color=\"error\" depressed @click=\"close\"> Close </v-btn>\n          <v-btn color=\"green white--text\" @click=\"updateTopic\"> Save </v-btn>\n        </v-card-actions>\n      </v-card>\n    </v-dialog>\n  </v-col>\n</template>\n\n<script>\nimport userService from '../../Services/user.service'\nexport default {\n  data: () => ({\n    tab: null,\n\n    editedIndex: -1,\n     required(property) {\n      return (v) => (v && v.length > 0) || `You Must Input a ${property}`;\n    },\n    minLength(property, minLength) {\n      return (v) =>\n        v.length >= minLength ||\n        `${property} must be at least ${minLength} characters`;\n    },\n    maxLength(property, maxLength) {\n      return (v) =>\n        v.length <= maxLength ||\n        `${property} must be at least ${maxLength} characters`;\n    },\n    getColor(credits) {\n      if (credits >= 1 && credits < 3) {\n        return \"red\";\n      } else if (credits >= 3 && credits < 5) return \"yellow\";\n      else return \"green\";\n    },\n  }),\n  methods: {\n\n     async updateTopic() {\n      //this.item=this.editeItem\n\n    await userService.updateTopic(this.item).then((response)=>{\n      if(response.data.success==true){\n        this.loading=false;\n        this.$emit('successSnackbar',response.data.message)\n      }\n      else{\n        this.$emit('errorSnackbar',response.data.message)\n      }\n    });\n      this.item = \"\";\n      this.editDialog = false;\n      this.$emit(\"updateDialog\", false);\n      this.$emit('updateTopics')\n    },\n    editItem(item) {\n      this.editedIndex = this.topics.indexOf(item);\n\n      this.editedItem = Object.assign({}, item);\n\n      this.dialog = true;\n    },\n    save() {\n      if (this.editedIndex > -1) {\n        Object.assign(this.desserts[this.editedIndex], this.editedItem);\n      } else {\n        this.desserts.push(this.editedItem);\n      }\n      this.close();\n    },\n    close() {\n      this.editDialog = false;\n      this.$nextTick(() => {\n        this.item = \"\";\n        this.$emit(\"updateDialog\", false);\n      });\n    },\n    \n  },\n\n  props: {\n    editDialog: Boolean,\n    item: Object,\n  },\n  watch: {\n      dialog(val) {\n        val || this.close();\n      },\n      dialogDelete(val) {\n        val || this.closeDelete();\n      },\n    },\n};\n</script>\n\n<style>\n</style>"],"sourceRoot":"src/components/PopupComponents"}]}
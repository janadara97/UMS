         <v-col cols=\"12\" md=\"8\">\n            <v-card max-height=\"500\">\n              <v-tabs v-model=\"tab\" background-color=\"primary\">\n                <v-tab class=\"white--text\" > Table View </v-tab>\n                <v-tab class=\"white--text\" > Grid View </v-tab>\n              </v-tabs>\n\n              <v-tabs-items v-model=\"tab\">\n                <v-tab-item >\n                  <v-card-title>\n                    <v-text-field\n                      v-model=\"search\"\n                      append-icon=\"mdi-magnify\"\n                      label=\"Search\"\n                      single-line\n                      hide-details\n                    >\n                    </v-text-field>\n                  </v-card-title>\n                  <v-data-table\n                    :headers=\"headers\"\n                    items-per-page=\"10\"\n                    class=\"elevation-1\"\n                    :search=\"search\"\n                    :items=\"users\"\n                  >\n                    <template v-slot:[`item.Actions`]=\"{ item }\">\n                      <v-row>\n                        <v-col cols=\"12\" md=\"4\">\n                          <v-dialog\n                            v-model=\"dialog\"\n                            persistent\n                            max-width=\"600px\"\n                            :retain-focus=\"false\"\n                          >\n                            <template v-slot:activator=\"{ on, attrs }\">\n                              <v-btn\n                                rounded\n                                color=\"#1C2842\"\n                                class=\"white--text\"\n                                v-bind=\"attrs\"\n                                v-on=\"on\"\n                                @click=\"editItem(item)\"\n                              >\n                                Edit\n                              </v-btn>\n                            </template>\n                            <v-card>\n                              <v-card-title>\n                                <span class=\"text-h5\">User Profile</span>\n                              </v-card-title>\n                              <v-card-text>\n                                <v-container>\n                                  <v-row>\n                                    <v-col cols=\"12\">\n                                      <v-text-field\n                                        label=\"Name*\"\n                                        required\n                                        v-model=\"editedItem.Name\"\n                                        :rules=\"[\n                                          required('Name'),\n                                          minLength('Name', 5),\n                                          maxLength('Name', 50),\n                                        ]\"\n                                      ></v-text-field>\n                                    </v-col>\n                                    <v-col cols=\"12\">\n                                      <v-text-field\n                                        label=\"User Name*\"\n                                        required\n                                        v-model=\"editedItem.UserName\"\n                                        :rules=\"[\n                                          required('UserName'),\n                                          minLength('UserName', 5),\n                                          maxLength('UserName', 50),\n                                        ]\"\n                                      ></v-text-field>\n                                    </v-col>\n\n                                    <v-col cols=\"12\" sm=\"6\">\n                                      <v-select\n                                        :items=\"[\n                                          'Admin',\n                                          'Lecturer',\n                                          'Student',\n                                        ]\"\n                                        label=\"Role\"\n                                        required\n                                        :rules=\"[required('Role')]\"\n                                        v-model=\"editedItem.Role\"\n                                      ></v-select>\n                                    </v-col>\n                                    <v-col cols=\"12\" sm=\"6\" md=\"12\">\n                                      <v-combobox\n                                        v-model=\"editedItem.Authorities\"\n                                        :items=\"users.Authorities\"\n                                        clearable\n                                        label=\"Select Authorities\"\n                                        multiple\n                                        solo\n                                        :rules=\"[required('Authorities')]\"\n                                      >\n                                        <template\n                                          v-slot:selection=\"{\n                                            attrs,\n                                            item,\n                                            select,\n                                            selected,\n                                          }\"\n                                        >\n                                          <v-chip\n                                            v-bind=\"attrs\"\n                                            :input-value=\"selected\"\n                                            close\n                                            @click=\"select\"\n                                            @click:close=\"remove(item)\"\n                                          >\n                                            <strong>{{ item }}</strong\n                                            >&nbsp;\n                                          </v-chip>\n                                        </template>\n                                      </v-combobox>\n                                    </v-col>\n                                  </v-row>\n                                </v-container>\n                                <small>*indicates required field</small>\n                              </v-card-text>\n                              <v-card-actions>\n                                <v-spacer></v-spacer>\n                                <v-btn\n                                  color=\"blue darken-1\"\n                                  text\n                                  @click=\"close\"\n                                >\n                                  Close\n                                </v-btn>\n                                <v-btn color=\"blue darken-1\" text @click=\"save\">\n                                  Save\n                                </v-btn>\n                              </v-card-actions>\n                            </v-card>\n                          </v-dialog>\n                        </v-col>\n                        <v-flex md2>\n                          <delete-confirm-popup />\n                        </v-flex>\n                      </v-row>\n                    </template>\n                  </v-data-table>\n                </v-tab-item>\n\n                <v-tab-item >\n                  <v-row class=\"mx-3\">\n                    <!-- v-card modules -->\n                    <v-col cols=\"12\" md=\"12\" class=\"pl-0 px-7 mr-0\">\n                      <v-card class=\"my-5\">\n                        <v-card-subtitle class=\"grey--text\"\n                          >All Users</v-card-subtitle\n                        >\n                        <v-row>\n                          <v-col\n                            cols=\"12\"\n                            md=\"3\"\n                            v-for=\"user in users\"\n                            :key=\"user.UserName\"\n                          >\n                            <v-hover v-slot=\"{ hover }\" open-delay=\"100\">\n                              <v-card class=\"ma-5\" :elevation=\"hover ? 20 : 8\">\n                                <v-content>\n                                  <img class=\"mr-15\" :src=\"user.image\" alt=\"\" />\n                                </v-content>\n                                <v-card-title class=\"justify-center\">\n                                  <v-chip color=\"yellow\">{{\n                                    user.Role\n                                  }}</v-chip>\n\n                                  <v-spacer></v-spacer>\n                                  <span>{{ user.UserName }}</span>\n                                </v-card-title>\n\n                                <v-card-subtitle>\n                                  <span class=\"mt-5\"\n                                    >Assigned Authorities :-\n                                  </span></v-card-subtitle\n                                >\n                                <ul>\n                                  <li\n                                   \n                                    class=\"grey--text\"\n                                   \n                                  >\n                                    {{ user.Authorities }}\n                                  </li>\n                                </ul>\n\n                                <v-card-actions class=\"justify-center\">\n                                  <div class=\"text-center\">\n                                    <v-btn color=\"primary\"> Message </v-btn>\n                                  </div>\n                                </v-card-actions>\n                              </v-card>\n                            </v-hover>\n                          </v-col>\n                        </v-row>\n                      </v-card>\n                    </v-col>\n                  </v-row>\n                </v-tab-item>\n              </v-tabs-items>\n            </v-card>\n          </v-col>\n          <v-col cols=\"12\" md=\"4\">\n            <add-notice @notice-added=\"addNotice\"></add-notice>\n          </v-col>\n        </v-row>\n      </v-container>\n    </div>\n  </v-app>\n</template>\n\n<script>\nimport AddUserPopup from \"../PopupComponents/AddUserPopup.vue\";\n//import EditUserPopup from \"../../PopupComponents/EditUserPopup.vue\";\nimport DeleteConfirmPopup from \"../PopupComponents/DeleteConfirmPopup.vue\";\nimport AddNotice from \"../Widgets/AddNotice.vue\";\n//import Calender from \"../Widgets/Calender.vue\";\nexport default {\n  components: {\n    AddUserPopup,\n    DeleteConfirmPopup,\n    AddNotice,\n    //Calender,\n  },\n\n  data() {\n    return {\n      notice: [\n        {\n          name: \"\",\n          message: \"\",\n        },\n      ],\n      tab: null,\n\n      search: \"\",\n      dialog: false,\n      dialogDelete: false,\n      editedIndex: -1,\n\n      editedItem: {\n        UserName: \"\",\n        Role: \"\",\n        Authorities: [],\n      },\n      defaultItem: {\n        UserName: \"\",\n        Role: \"\",\n        Authorities: [],\n      },\n      users: [],\n      headers: [\n        {\n          text: \"User Name\",\n          align: \"start\",\n          sortable: \"false\",\n          value: \"UserName\",\n        },\n        { text: \"Role\", value: \"Role\" },\n        { text: \"Authorities\", value: \"Authorities\" },\n        { text: \"Actions\", value: \"Actions\" },\n      ],\n      required(property) {\n        return (v) => (v && v.length > 0) || `You Must Input a ${property}`;\n      },\n      minLength(property, minLength) {\n        return (v) =>\n          v.length >= minLength ||\n          `${property} must be at least ${minLength} characters`;\n      },\n      maxLength(property, maxLength) {\n        return (v) =>\n          v.length <= maxLength ||\n          `${property} must be at least ${maxLength} characters`;\n      },\n    };\n  },\n  created() {\n    this.userInitilize();\n  },\n  watch: {\n    dialog(val) {\n      val || this.close();\n    },\n    dialogDelete(val) {\n      val || this.closeDelete();\n    },\n  },\n  methods: {\n    addUser(user){\n     \n      this.users.push({UserName:user.UserName,Role:user.role,Authorities:user.authorities})\n    },\n    \n    // userInitilize() {\n    //   this.users = [\n    //     {\n    //       UserName: \"janadara97\",\n    //       Role: \"Admin\",\n    //       image: require(\"../../assets/admin.svg\"),\n    //       Authorities: [\n    //         {\n    //           Id: \"1\",\n    //           Name: \"Read_User_Data\",\n    //         },\n    //         {\n    //           Id: \"2\",\n    //           Name: \"Write_User_Data\",\n    //         },\n    //         {\n    //           Id: \"1\",\n    //           Name: \"Read_User_Data\",\n    //         },\n    //         {\n    //           Id: \"3\",\n    //           Name: \"Delete_User_Data\",\n    //         },\n    //         {\n    //           Id: \"4\",\n    //           Name: \"Read_Lecturer_Data\",\n    //         },\n    //         {\n    //           Id: \"5\",\n    //           Name: \"Write_Lecturer_Data\",\n    //         },\n    //         {\n    //           Id: \"6\",\n    //           Name: \"Delete_Lecturer_Data\",\n    //         },\n    //         {\n    //           Id: \"7\",\n    //           Name: \"Read_Student_Data\",\n    //         },\n    //         {\n    //           Id: \"8\",\n    //           Name: \"Write_Student_Data\",\n    //         },\n    //         {\n    //           Id: \"9\",\n    //           Name: \"Delete_Student_Data\",\n    //         },\n    //       ],\n    //     },\n    //     {\n    //       UserName: \"kasun97\",\n    //       Role: \"Lecturer\",\n    //       image: require(\"../../assets/lecturer.svg\"),\n    //       Authorities: [\n    //         {\n    //           Id: \"4\",\n    //           Name: \"Read_Lecturer_Data\",\n    //         },\n    //         {\n    //           Id: \"5\",\n    //           Name: \"Write_Lecturer_Data\",\n    //         },\n    //         {\n    //           Id: \"6\",\n    //           Name: \"Delete_Lecturer_Data\",\n    //         },\n    //       ],\n    //     },\n    //     {\n    //       UserName: \"chathura97\",\n    //       Role: \"Student\",\n    //       image: require(\"../../assets/student.svg\"),\n    //       Authorities: [\n    //         {\n    //           Id: \"7\",\n    //           Name: \"Read_Student_Data\",\n    //         },\n    //         {\n    //           Id: \"8\",\n    //           Name: \"Write_Student_Data\",\n    //         },\n    //         {\n    //           Id: \"9\",\n    //           Name: \"Delete_Student_Data\",\n    //         },\n    //       ],\n    //     },\n    //     {\n    //       UserName: \"kavinda97\",\n    //       Role: \"Lecturer\",\n    //       image: require(\"../../assets/lecturer.svg\"),\n    //       Authorities: [\n    //         {\n    //           Id: \"4\",\n    //           Name: \"Read_Lecturer_Data\",\n    //         },\n    //         {\n    //           Id: \"5\",\n    //           Name: \"Write_Lecturer_Data\",\n    //         },\n    //         {\n    //           Id: \"6\",\n    //           Name: \"Delete_Lecturer_Data\",\n    //         },\n    //       ],\n    //     },\n    //     {\n    //       UserName: \"mahinsa97\",\n    //       Role: \"Admin\",\n    //       image: require(\"../../assets/admin.svg\"),\n    //       Authorities: [\n    //         {\n    //           Id: \"1\",\n    //           Name: \"Read_User_Data\",\n    //         },\n    //         {\n    //           Id: \"2\",\n    //           Name: \"Write_User_Data\",\n    //         },\n\n    //         {\n    //           Id: \"3\",\n    //           Name: \"Delete_User_Data\",\n    //         },\n    //         {\n    //           Id: \"4\",\n    //           Name: \"Read_Lecturer_Data\",\n    //         },\n    //         {\n    //           Id: \"5\",\n    //           Name: \"Write_Lecturer_Data\",\n    //         },\n    //         {\n    //           Id: \"6\",\n    //           Name: \"Delete_Lecturer_Data\",\n    //         },\n    //         {\n    //           Id: \"7\",\n    //           Name: \"Read_Student_Data\",\n    //         },\n    //         {\n    //           Id: \"8\",\n    //           Name: \"Write_Student_Data\",\n    //         },\n    //         {\n    //           Id: \"9\",\n    //           Name: \"Delete_Student_Data\",\n    //         },\n    //       ],\n    //     },\n    //   ];\n    // },\n    userInitilize() {\n      this.users = [\n        {\n          UserName: \"janadara97\",\n          Role: \"Admin\",\n          image: require(\"../../assets/admin.svg\"),\n          Authorities: [\n            \"Read_User_Data\",\n\n            \"Write_User_Data\",\n\n            \"Read_User_Data\",\n\n            \"Delete_User_Data\",\n\n            \"Read_Lecturer_Data\",\n\n            \"Write_Lecturer_Data\",\n\n            \"Delete_Lecturer_Data\",\n\n            \"Read_Student_Data\",\n\n            \"Write_Student_Data\",\n\n            \"Delete_Student_Data\",\n          ],\n        },\n        {\n          UserName: \"kasun97\",\n          Role: \"Lecturer\",\n          image: require(\"../../assets/lecturer.svg\"),\n          Authorities: [\n            \"Read_Lecturer_Data\",\n\n            \"Write_Lecturer_Data\",\n\n            \"Delete_Lecturer_Data\",\n          ],\n        },\n        {\n          UserName: \"chathura97\",\n          Role: \"Student\",\n          image: require(\"../../assets/student.svg\"),\n          Authorities: [\n            \"Read_Student_Data\",\n\n            \"Write_Student_Data\",\n\n            \"Delete_Student_Data\",\n          ],\n        },\n        {\n          UserName: \"kavinda97\",\n          Role: \"Lecturer\",\n          image: require(\"../../assets/lecturer.svg\"),\n          Authorities: [\n            \"Read_Lecturer_Data\",\n\n            \"Write_Lecturer_Data\",\n\n            \"Delete_Lecturer_Data\",\n          ],\n        },\n        {\n          UserName: \"mahinsa97\",\n          Role: \"Admin\",\n          image: require(\"../../assets/admin.svg\"),\n          Authorities: [\n            \"Read_User_Data\",\n\n            \"Write_User_Data\",\n\n            \"Read_User_Data\",\n\n            \"Delete_User_Data\",\n\n            \"Read_Lecturer_Data\",\n\n            \"Write_Lecturer_Data\",\n\n            \"Delete_Lecturer_Data\",\n\n            \"Read_Student_Data\",\n\n            \"Write_Student_Data\",\n\n            \"Delete_Student_Data\",\n          ],\n        },\n      ];\n    },\n    editItem(item) {\n      this.editedIndex = this.users.indexOf(item);\n\n      this.editedItem = Object.assign({}, item);\n\n      this.dialog = true;\n    },\n    save() {\n      if (this.editedIndex > -1) {\n        Object.assign(this.desserts[this.editedIndex], this.editedItem);\n      } else {\n        this.desserts.push(this.editedItem);\n      }\n      this.close();\n    },\n    close() {\n      this.dialog = false;\n      this.$nextTick(() => {\n        this.editedItem = Object.assign({}, this.defaultItem);\n\n        this.editedIndex = -1;\n      });\n    },\n  },\n};\n</script>\n\n<style>\n</style>"],"sourceRoot":"src/components/Views"}]}
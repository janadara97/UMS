d: black\" class=\"white--text\"\n        >Academin Progress</v-card-title\n      >\n      <v-container>\n        <v-row justify=\"center\" align=\"center\">\n          <v-col\n            cols=\"12\"\n            v-for=\"progress in progress\"\n            :key=\"progress.progressName\"\n          >\n            <div>{{ progress.progressName }}</div>\n            <v-progress-linear\n              :color=\"setProgressBarColours(progress.progressValue)\"\n              height=\"25\"\n              :value=\"progress.progressValue\"\n              striped\n            >\n              <template v-slot:default=\"{ value }\">\n                <strong>{{ Math.ceil(value) }}%</strong>\n              </template>\n            </v-progress-linear>\n          </v-col>\n        </v-row>\n      </v-container>\n    </v-card>\n  </v-col>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      progress: [\n        {\n          progressName: \"Grade Average\",\n          progressValue: \"78\",\n        },\n        {\n          progressName: \"Your Last Test\",\n          progressValue: \"65\",\n        },\n        {\n          progressName: \"Your Last Assignment\",\n          progressValue: \"12\",\n        },\n        {\n          progressName: \"Your Attendance\",\n          progressValue: \"45\",\n        },\n        {\n          progressName: \"Graduation Progress \",\n          progressValue: \"65\",\n        },\n      ],\n    };\n  },\n  methods: {\n    setProgressBarColours(value) {\n      if (value >= 0 && value <= 25) {\n        return \"red\";\n      } else if (value > 25 && value <= 50) {\n        return \"yellow\";\n      } else if (value > 50 && value <= 75) {\n        return \"blue\";\n      } else if (value > 75 && value <= 100) {\n        return \"green\";\n      }\n    },\n  },\n};\n</script>\n\n<style>\n</style>"],"sourceRoot":"src/components/Widgets"}]}
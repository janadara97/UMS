;AACA,IAAA,SADA,uBACA;AACA,WAAA,OAAA,CAAA,IAAA,CAAA,WAAA;AACA,KAHA;AAIA,IAAA,eAJA,2BAIA,OAJA,EAIA;AAAA;;AAAA;AAAA;AAAA;AAAA;AAAA;AAEA,gBAAA,KAAA,CAAA,QAAA,GAAA,IAAA;AAEA,gBAAA,KAAA,CAAA,WAAA,GAAA,SAAA;AACA,gBAAA,KAAA,CAAA,SAAA,GAAA,cAAA;AACA,gBAAA,KAAA,CAAA,SAAA,GAAA,OAAA;AANA;AAAA,uBAQA,IAAA,OAAA,CAAA,UAAA,OAAA;AAAA,yBAAA,UAAA,CAAA,OAAA,EAAA,IAAA,CAAA;AAAA,iBAAA,CARA;;AAAA;AASA,gBAAA,KAAA,CAAA,QAAA,GAAA,KAAA;;AATA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAUA,KAdA;AAeA,IAAA,aAfA,yBAeA,OAfA,EAeA;AAAA;;AAAA;AAAA;AAAA;AAAA;AAAA;AAEA,gBAAA,MAAA,CAAA,QAAA,GAAA,IAAA;AAEA,gBAAA,MAAA,CAAA,WAAA,GAAA,OAAA;AACA,gBAAA,MAAA,CAAA,SAAA,GAAA,OAAA;AACA,gBAAA,MAAA,CAAA,SAAA,GAAA,OAAA;AANA;AAAA,uBAQA,IAAA,OAAA,CAAA,UAAA,OAAA;AAAA,yBAAA,UAAA,CAAA,OAAA,EAAA,IAAA,CAAA;AAAA,iBAAA,CARA;;AAAA;AASA,gBAAA,MAAA,CAAA,QAAA,GAAA,KAAA;;AATA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAUA,KAzBA;AA0BA,IAAA,WA1BA,yBA0BA;AAAA;;AAAA;AAAA;AAAA;AAAA;AAAA;AACA,oBAAA,MAAA,CAAA,IAAA,CAAA,QAAA,IAAA,MAAA,CAAA,IAAA,CAAA,QAAA,EAAA;AAEA,kBAAA,MAAA,CAAA,MAAA,CAAA,QAAA,CAAA,YAAA,EAAA,MAAA,CAAA,IAAA,EAAA,IAAA,CACA,UAAA,QAAA,EAAA;AACA,oBAAA,MAAA,CAAA,eAAA,CAAA,QAAA,CAAA,OAAA;;AACA,oBAAA,UAAA,CAAA,MAAA,CAAA,SAAA,EAAA,IAAA,CAAA,CAFA,CAGA;AACA,mBALA,EAQA,KARA,CAQA,UAAA,QAAA,EAAA;AACA,oBAAA,OAAA,CAAA,GAAA,CAAA,OAAA;;AACA,oBAAA,MAAA,CAAA,aAAA,CAAA,QAAA,CAAA,OAAA;AACA,mBAXA;AAYA;;AAfA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAgBA;AA1CA,GAnCA;AAgFA,EAAA,QAAA,EAAA;AACA,IAAA,QADA,sBACA;AACA,aAAA,KAAA,MAAA,CAAA,KAAA,CAAA,IAAA,CAAA,MAAA,CAAA,QAAA;AACA;AAHA,GAhFA;AAqFA,EAAA,OArFA,qBAqFA;AACA,QAAA,KAAA,QAAA,EAAA;AACA,WAAA,OAAA,CAAA,IAAA,CAAA,YAAA;AACA;AACA;AAzFA,CAAA","sourcesContent":[" <template>\n  <div\n    :style=\"{\n      backgroundImage: 'url(' + require('../../assets/background.jpg') + ')',\n    }\"\n    class=\"background\"\n  >\n   <comfirmation-snack-bar\n        :timeout=\"2000\"\n        :snackbar=\"snackbar\"\n        :snackColour=\"snackColour\"\n        :snackIcon=\"snackIcon\"\n        :SnackText=\"snackText\"\n      />\n  \n    <v-card class=\"v-card\" max-width=\"1300\" height=\"600\">\n      <v-container class=\"container\">\n        <v-row class=\"pa-2\">\n          <v-col sm=\"12\" md=\"7\" class=\"loginIcon\"> </v-col>\n          <v-col class=\"loginArea\" md=\"5\" sm=\"12\">\n            <div class=\"text-center\">\n              <v-avatar color=\"indigo lighten-4\">\n                <v-icon color=\"indigo\" size=\"40\">account_circle</v-icon>\n              </v-avatar>\n              <h3 class=\"indigo--text\">UMS LOGIN</h3>\n            </div>\n            <v-form @submit.prevent=\"handleLogin\">\n              <v-card-text>\n                <v-text-field\n                  label=\"User Name\"\n                  placeholder=\"username\"\n                  v-model=\"user.userName\"\n                  :rules=\"[\n                    required('UserName'),\n                    minLength('UserName', 5),\n                    maxLength('UserName', 10),\n                  ]\"\n                  prepend-inner-icon=\"mdi-account\"\n                >\n                </v-text-field>\n              </v-card-text>\n              <v-card-text>\n                <v-text-field\n                  :type=\"showPassword ? 'text' : 'password'\"\n                  label=\"Password\"\n                  placeholder=\"password\"\n                  prepend-inner-icon=\"mdi-key\"\n                  :append-icon=\"showPassword ? 'mdi-eye' : 'mdi-eye-off'\"\n                  v-model=\"user.password\"\n                  :rules=\"[\n                    required('password'),\n                    \n                  ]\"\n                  @click:append=\"showPassword = !showPassword\"\n                >\n                </v-text-field>\n\n                <v-switch label=\"Remember Me\" color=\"indigo\"> </v-switch>\n              </v-card-text>\n              <v-card-actions class=\"justify-center\">\n                <v-btn color=\"indigo px-5\" type=\"submit\">\n                  <span class=\"white--text\">LOGIN</span>\n                </v-btn>\n              </v-card-actions>\n              <div v-if=\"message\" class=\"grey\">\n                <v-alert>\n                  {{ message }}\n                </v-alert>\n              </div>\n            </v-form>\n          </v-col>\n        </v-row>\n      </v-container>\n    </v-card>\n  </div>\n</template>\n\n<script>\nimport ComfirmationSnackBar from '../Widgets/comfirmationSnackBar.vue'\nexport default {\n\n  components:{\n    ComfirmationSnackBar\n  },\n  data() {\n    return {\n      snackbar:false,\n      snackColour:\"\",\n      snackIcon:\"\",\n      snackText:\"\",\n\n\n      user: {\n        userName: \"\",\n        password: \"\",\n      },\n      message: \"\",\n      image: \"/assets/background.jpg\",\n      showPassword: false,\n      required(property) {\n        return (v) => (v && v.length > 0) || `You Must Input a ${property}`;\n      },\n      minLength(property, minLength) {\n        return (v) =>\n          v.length >= minLength ||\n          `${property} must be at least ${minLength} characters`;\n      },\n      maxLength(property, maxLength) {\n        return (v) =>\n          v.length <= maxLength ||\n          `${property} must be at least ${maxLength} characters`;\n      },\n    };\n  },\n  methods: {\n    dashboard() {\n      this.$router.push(\"dashboard\");\n    },\n    async successSnackbar(message) {\n      \n      this.snackbar = true;\n\n      this.snackColour = \"#43A047\";\n      this.snackIcon = \"check_circle\"; \n      this.snackText = message;\n\n      await new Promise((resolve) => setTimeout(resolve, 2000));\n      this.snackbar = false;\n    },\n    async errorSnackbar(message) {\n     \n      this.snackbar = true;\n      \n      this.snackColour = \"error\";\n      this.snackIcon = \"error\";\n      this.snackText = message;\n\n      await new Promise((resolve) => setTimeout(resolve, 2000));\n      this.snackbar = false;\n    },\n  async  handleLogin() {\n      if (this.user.userName && this.user.password) {\n    \n        this.$store.dispatch(\"auth/login\", this.user).then(\n          (response) => {\n            this.successSnackbar(response.message);\n            setTimeout(this.dashboard, 1000)\n           // this.$router.push(\"/dashboard\");\n          },\n          \n          \n        ).catch((response)=>{\n          console.log(\"error\")\n          this.errorSnackbar(response.message)\n        })\n      }\n    },\n    \n  },\n  computed: {\n    loggedIn() {\n      return this.$store.state.auth.status.loggedIn;\n    },\n  },\n  created() {\n    if (this.loggedIn) {\n      this.$router.push(\"/dashboard\");\n    }\n  },\n};\n</script>\n\n<style scoped>\n.background {\n  height: 100%;\n  width: 100%;\n  display: block;\n  position: absolute;\n  top: 0;\n  background-size: cover;\n}\n.loginIcon {\n  height: 550px;\n  background-image: url(\"../../assets/login.png\");\n  background-size: 100%;\n}\n.v-card {\n  margin: 150px auto;\n}\n.loginArea {\n  height: 550px;\n  margin-top: 50px;\n}\n.container {\n  width: 1400;\n}\n</style>"],"sourceRoot":"src/components/Views"}]}
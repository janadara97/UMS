A,gBADA;AAAA,SAAA;AAGA;AAlCA,KAAA;AAAA,GADA;AAqCA,EAAA,OAAA,EAAA;AACA,IAAA,QADA,sBACA;AAAA;;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,uBACA,WAAA,CAAA,QAAA,CAAA,KAAA,CAAA,KAAA,EAAA,IAAA,CAAA,UAAA,QAAA,EAAA;AACA,sBAAA,QAAA,CAAA,IAAA,CAAA,OAAA,IAAA,IAAA,EAAA;AACA,oBAAA,KAAA,CAAA,OAAA,GAAA,KAAA;;AACA,oBAAA,KAAA,CAAA,KAAA,CAAA,iBAAA,EAAA,QAAA,CAAA,IAAA,CAAA,OAAA;AACA,mBAHA,MAIA;AACA,oBAAA,KAAA,CAAA,KAAA,CAAA,eAAA,EAAA,QAAA,CAAA,IAAA,CAAA,OAAA;AACA;AACA,iBARA,CADA;;AAAA;AAUA,gBAAA,KAAA,CAAA,KAAA,CAAA,aAAA;;AACA,gBAAA,KAAA,CAAA,SAAA,CAAA,YAAA;AACA,kBAAA,KAAA,CAAA,KAAA,GAAA,MAAA,CAAA,MAAA,CAAA,EAAA,EAAA,KAAA,CAAA,YAAA,CAAA;AACA,kBAAA,KAAA,CAAA,MAAA,GAAA,KAAA;AACA,iBAHA;;AAXA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAeA;AAhBA,GArCA;AAuDA,EAAA,IAAA,EAAA;AAvDA,CAAA","sourcesContent":["<template>\n  <v-row>\n    <v-dialog v-model=\"dialog\" persistent max-width=\"500px\">\n      <template v-slot:activator=\"{ on, attrs }\">\n        <v-btn color=\"#1C2842\" dark v-bind=\"attrs\" v-on=\"on\">\n          <v-icon left>add</v-icon>\n          Add Topic\n        </v-btn>\n      </template>\n      <v-card>\n        <v-layout row>\n          <v-flex class=\"primary white--text text-center\">\n            <v-card-title>\n              <span class=\"text-h5 pa-5\">Add Topic</span>\n            </v-card-title>\n          </v-flex>\n        </v-layout>\n\n        <v-card-text>\n          <v-container>\n            <v-row>\n              <v-col cols=\"12\">\n                <v-text-field\n                  label=\"Module Id*\"\n                  required\n                  v-model=\"topic.moduleId\"\n                  :rules=\"[required('Name')]\"\n                ></v-text-field>\n              </v-col>\n              <v-col cols=\"12\">\n                <v-text-field\n                  label=\"Topic Id*\"\n                  required\n                  v-model=\"topic.tId\"\n                  :rules=\"[required('Name')]\"\n                ></v-text-field>\n              </v-col>\n              <v-col cols=\"12\">\n                <v-text-field\n                  label=\"Topic Name*\"\n                  required\n                  v-model=\"topic.tName\"\n                  :rules=\"[\n                    required('Name'),\n                    minLength('Name', 5),\n                    maxLength('Name', 20),\n                  ]\"\n                ></v-text-field>\n              </v-col>\n              <v-col cols=\"12\">\n                <v-text-field\n                  label=\"Topic Description*\"\n                  v-model=\"topic.tDes\"\n                  :rules=\"[\n                    required('Description'),\n                    minLength('Description', 20),\n                    maxLength('Description', 200),\n                  ]\"\n                ></v-text-field>\n              </v-col>\n              \n            </v-row>\n          </v-container>\n          <small>*indicates required field</small>\n        </v-card-text>\n        <v-card-actions>\n          <v-spacer></v-spacer>\n          <v-btn color=\"error\" depressed @click=\"dialog = false\"> Close </v-btn>\n          <v-btn :loading=\"loading\" color=\"green white--text\" @click.prevent=\"addTopic\">\n            Save\n          </v-btn>\n        </v-card-actions>\n      </v-card>\n    </v-dialog>\n  </v-row>\n</template>\n\n<script>\nimport userService from \"../../Services/user.service\";\nexport default {\n  data: () => ({\n    loading:false,\n    topic: [\n      {\n        tId: null,\n       tName: \"\",\n        tDes: \"\",\n        moduleId: null,\n        \n      },\n    ],\n    defaultTopic: [\n      {\n        tId: null,\n       tName: \"\",\n        tDes: \"\",\n        moduleId: null,\n        \n      },\n    ],\n\n    dialog: false,\n    required(property) {\n      return (v) => (v && v.length > 0) || `You Must Input a ${property}`;\n    },\n    minLength(property, minLength) {\n      return (v) =>\n        v.length >= minLength ||\n        `${property} must be at least ${minLength} characters`;\n    },\n    maxLength(property, maxLength) {\n      return (v) =>\n        v.length <= maxLength ||\n        `${property} must be at least ${maxLength} characters`;\n    },\n  }),\n  methods: {\n    async addTopic() {\n     await userService.addTopic(this.topic).then((response) => {\n        if(response.data.success==true){\n          this.loading=false;\n          this.$emit('successSnackbar',response.data.message)\n        }\n        else{\n          this.$emit('errorSnackbar',response.data.message)\n        }\n      });\n      this.$emit(\"updateTable\")\n      this.$nextTick(() => {\n        this.topic = Object.assign({}, this.defaultTopic);\n        this.dialog = false;\n      });\n    },\n  },\n  name: \"AddModulePopup\",\n};\n</script>\n\n<style>\n</style>"],"sourceRoot":"src/components/PopupComponents"}]}
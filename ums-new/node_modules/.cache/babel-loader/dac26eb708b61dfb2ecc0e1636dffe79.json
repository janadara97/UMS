{"remainingRequest":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/babel-loader/lib/index.js!/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/cache-loader/dist/cjs.js??ref--0-0!/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/vue-loader/lib/index.js??vue-loader-options!/home/jana/Projects/Vue/UMS-New/ums-new/src/components/PopupComponents/EditTopicPopups.vue?vue&type=script&lang=js&","dependencies":[{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/src/components/PopupComponents/EditTopicPopups.vue","mtime":1630250197969},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/babel-loader/lib/index.js","mtime":315532800000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/home/jana/Projects/Vue/UMS-New/ums-new/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["EditTopicPopups.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAsEA,eAAA;AACA,EAAA,IAAA,EAAA;AAAA,WAAA;AACA,MAAA,MAAA,EAAA,KADA;AAEA,MAAA,YAAA,EAAA,KAFA;AAGA,MAAA,WAAA,EAAA,CAAA,CAHA;AAIA,MAAA,UAAA,EAAA;AACA,QAAA,IAAA,EAAA,EADA;AAEA,QAAA,WAAA,EAAA;AAFA,OAJA;AAQA,MAAA,WAAA,EAAA;AACA,QAAA,IAAA,EAAA,EADA;AAEA,QAAA,WAAA,EAAA;AAFA;AARA,KAAA;AAAA,GADA;AAcA,EAAA,OAAA,EAAA;AACA,IAAA,QADA,oBACA,IADA,EACA;AACA,WAAA,WAAA,GAAA,KAAA,MAAA,CAAA,OAAA,CAAA,IAAA,CAAA;AAEA,WAAA,UAAA,GAAA,MAAA,CAAA,MAAA,CAAA,EAAA,EAAA,IAAA,CAAA;AAEA,WAAA,MAAA,GAAA,IAAA;AACA,KAPA;AAQA,IAAA,IARA,kBAQA;AACA,UAAA,KAAA,WAAA,GAAA,CAAA,CAAA,EAAA;AACA,QAAA,MAAA,CAAA,MAAA,CAAA,KAAA,QAAA,CAAA,KAAA,WAAA,CAAA,EAAA,KAAA,UAAA;AACA,OAFA,MAEA;AACA,aAAA,QAAA,CAAA,IAAA,CAAA,KAAA,UAAA;AACA;;AACA,WAAA,KAAA;AACA,KAfA;AAgBA,IAAA,KAhBA,mBAgBA;AAAA;;AACA,WAAA,MAAA,GAAA,KAAA;AACA,WAAA,SAAA,CAAA,YAAA;AACA,QAAA,KAAA,CAAA,UAAA,GAAA,MAAA,CAAA,MAAA,CAAA,EAAA,EAAA,KAAA,CAAA,WAAA,CAAA;AAEA,QAAA,KAAA,CAAA,WAAA,GAAA,CAAA,CAAA;AACA,OAJA;AAKA,KAvBA;AAwBA,IAAA,KAAA,EAAA;AACA,MAAA,MADA,kBACA,GADA,EACA;AACA,QAAA,GAAA,IAAA,KAAA,KAAA,EAAA;AACA,OAHA;AAIA,MAAA,YAJA,wBAIA,GAJA,EAIA;AACA,QAAA,GAAA,IAAA,KAAA,WAAA,EAAA;AACA;AANA;AAxBA,GAdA;AAgDA,EAAA,KAAA,EAAA,CAAA,EAAA;AAhDA,CAAA","sourcesContent":["<template>\n  <v-col>\n    <v-dialog\n      v-model=\"dialog\"\n      persistent\n      max-width=\"500px\"\n      :retain-focus=\"false\"\n    >\n      <template v-slot:activator=\"{ on, attrs }\">\n        <v-btn\n          rounded\n          class=\"white--text\"\n          color=\"#1C2842\"\n          v-bind=\"attrs\"\n          v-on=\"on\"\n          @click=\"editItem(item)\"\n        >\n          Edit\n        </v-btn>\n      </template>\n\n      <v-card>\n        <v-layout row>\n          <v-flex class=\"primary white--text text-center\">\n            <v-card-title>\n              <span class=\"text-h5 pa-5\">Edit Topic</span>\n            </v-card-title>\n          </v-flex>\n        </v-layout>\n\n        <v-card-text>\n          <v-container>\n            <v-row>\n              <v-col cols=\"12\">\n                <v-text-field\n                  label=\"Topic Name*\"\n                  v-model=\"editedItem.Name\"\n                  :rules=\"[\n                    required('Name'),\n                    minLength('Name', 5),\n                    maxLength('Name', 50),\n                  ]\"\n                ></v-text-field>\n              </v-col>\n              <v-col cols=\"12\">\n                <v-text-field\n                  label=\"Topic Description*\"\n                  v-model=\"editedItem.Description\"\n                  :rules=\"[\n                    required('Description'),\n                    minLength('Description', 20),\n                    maxLength('Description', 200),\n                  ]\"\n                ></v-text-field>\n              </v-col>\n            </v-row>\n          </v-container>\n          <small>*indicates required field</small>\n        </v-card-text>\n        <v-card-actions>\n          <v-spacer></v-spacer>\n          <v-btn color=\"error\" depressed @click=\"close\"> Close </v-btn>\n          <v-btn color=\"green white--text\" @click=\"save\"> Save </v-btn>\n        </v-card-actions>\n      </v-card>\n    </v-dialog>\n  </v-col>\n</template>\n\n<script>\nexport default {\n  data: () => ({\n    dialog: false,\n    dialogDelete: false,\n    editedIndex: -1,\n    editedItem: {\n      Name: \"\",\n      Description: \"\",\n    },\n    defaultItem: {\n      Name: \"\",\n      Description: \"\",\n    },\n  }),\n  methods: {\n    editItem(item) {\n      this.editedIndex = this.topics.indexOf(item);\n\n      this.editedItem = Object.assign({}, item);\n\n      this.dialog = true;\n    },\n    save() {\n      if (this.editedIndex > -1) {\n        Object.assign(this.desserts[this.editedIndex], this.editedItem);\n      } else {\n        this.desserts.push(this.editedItem);\n      }\n      this.close();\n    },\n    close() {\n      this.dialog = false;\n      this.$nextTick(() => {\n        this.editedItem = Object.assign({}, this.defaultItem);\n\n        this.editedIndex = -1;\n      });\n    },\n    watch: {\n      dialog(val) {\n        val || this.close();\n      },\n      dialogDelete(val) {\n        val || this.closeDelete();\n      },\n    },\n  },\n\n  props: [\"\"],\n};\n</script>\n\n<style>\n</style>"],"sourceRoot":"src/components/PopupComponents"}]}
AAA,EAAA;AACA,WAAA,YAAA,GAAA,KAAA;AACA,WAAA,KAAA,CAAA,cAAA,EAAA,KAAA;AACA;AAxBA;AAbA,CAAA","sourcesContent":["<template>\n  <v-dialog\n    v-model=\"deleteDialog\"\n    persistent\n    max-width=\"500px\"\n    :retain-focus=\"false\"\n  >\n    <v-card>\n      <v-toolbar color=\"error\" dark>Alert !!!</v-toolbar>\n      <v-card-text>\n        <div class=\"text-h4 text-center py-12\">Are You Sure ?</div>\n      </v-card-text>\n      <v-card-actions class=\"justify-end\">\n        <v-btn text :loading=\"loading\" @click.prevent=\"confirmDelete\">Yes</v-btn>\n        <v-btn text @click=\"closeDelete\">Close</v-btn>\n      </v-card-actions>\n    </v-card>\n  </v-dialog>\n</template>\n\n<script>\nimport userService from \"../../Services/user.service\";\nexport default {\n  data() {\n    return {\n      loading:false\n    };\n  },\n\n  props: {\n    deleteDialog: Boolean,\n    itemId: String,\n   \n   \n  },\n  methods: {\n    async confirmDelete() {\n      \n      this.loading=true;\n      await userService.deleteUser(this.itemId).then((response) => {\n        if (response.data.success == true) {\n          this.loading=false;\n          this.$emit('successSnackbar',response.data.message)\n        }\n        else{\n          this.$emit('errorSnackbar',response.data.message)\n        }\n      });\n      this.deleteDialog = false;\n      this.$emit(\"deleteDialog\", false);\n      //for update the table\n      this.$emit(\"updateTable\");\n      \n    },\n\n    closeDelete() {\n      this.itemId = \"\";\n      this.deleteDialog = false;\n      this.$emit(\"deleteDialog\", false);\n    },\n  },\n};\n</script>\n\n<style>\n</style>"],"sourceRoot":"src/components/PopupComponents"}]}
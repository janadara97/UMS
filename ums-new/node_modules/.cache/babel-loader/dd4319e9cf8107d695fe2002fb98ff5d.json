xt-h5\">User Profile</span>\n        </v-card-title>\n        <v-card-text>\n          <v-container>\n            <v-row>\n              <v-col cols=\"12\">\n                <v-text-field label=\"Name*\" required></v-text-field>\n              </v-col>\n              <v-col cols=\"12\">\n                <v-text-field label=\"User Name*\" required></v-text-field>\n              </v-col>\n\n             \n\n              <v-col cols=\"12\" sm=\"6\">\n                <v-select\n                  :items=\"['Admin', 'Lecturer', 'Student']\"\n                  label=\"Role\"\n                  required\n                ></v-select>\n              </v-col>\n              <v-col cols=\"12\" sm=\"6\" md=\"12\">\n                \n                <v-combobox\n                  v-model=\"chips\"\n                  :items=\"items\"\n                  \n                  clearable\n                  label=\"Select Authorities\"\n                  multiple\n                 \n                  solo\n                >\n                  <template\n                    v-slot:selection=\"{ attrs, item, select, selected }\"\n                  >\n                    <v-chip\n                      v-bind=\"attrs\"\n                      :input-value=\"selected\"\n                      close\n                      @click=\"select\"\n                      @click:close=\"remove(item)\"\n                    >\n                      <strong>{{ item }}</strong\n                      >&nbsp;\n                     \n                    </v-chip>\n                  </template>\n                </v-combobox>\n              </v-col>\n            </v-row>\n          </v-container>\n          <small>*indicates required field</small>\n        </v-card-text>\n        <v-card-actions>\n          <v-spacer></v-spacer>\n          <v-btn color=\"blue darken-1\" text @click=\"dialog = false\">\n            Close\n          </v-btn>\n          <v-btn color=\"blue darken-1\" text @click=\"dialog = false\">\n            Save\n          </v-btn>\n        </v-card-actions>\n      </v-card>\n    </v-dialog>\n  </v-col>\n</template>\n\n<script>\n export default {\n    data () {\n      return {\n          dialog:false,\n        chips: ['Programming', 'Playing video games', 'Watching movies', 'Sleeping'],\n        items: ['Read_User_Data','Write_User_Data','Delete_User_Data','Read_Lecturer_Data','Write_Lecturer_Data','Delete_Lecturer_Data','Read_Student_Data','Write_Student_Data','Delete_Student_Data'],\n      }\n    },\n\n    methods: {\n      remove (item) {\n        this.chips.splice(this.chips.indexOf(item), 1)\n        this.chips = [...this.chips]\n      },\n    },\n  }\n</script>\n"],"sourceRoot":"src/components/PopupComponents"}]}
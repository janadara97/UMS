IAAA,CAAA,IAAA,CAAA,IAAA,CAAA,MAAA,MAAA,MAAA,GAAA,CAAA,CAAA,CAAA;AACA;AAPA;AAlJA,CAAA","sourcesContent":["<template>\n  <v-app :style=\"{ background: $vuetify.theme.themes.light.background }\">\n    <div class=\"dashboard ma-15\">\n      <v-container class=\"my-5\">\n        <v-row>\n          <v-col cols=\"2\" v-for=\"stat in stats\" :key=\"stat.user\">\n            <v-hover v-slot=\"{ hover }\" open-delay=\"200\">\n              <v-card\n                shaped\n                max-height=\"200\"\n                :elevation=\"hover ? 16 : 2\"\n                :class=\"{ 'on-hover': hover }\"\n              >\n                <v-row class=\"mx-auto\">\n                  <v-col cols=\"12\">\n                    <div class=\"avatar border\">\n                      <v-avatar size=\"100\">\n                        <img :src=\"stat.avatar\" />\n                      </v-avatar>\n                    </div>\n                  </v-col>\n                  <v-col cols=\"12\">\n                    <v-card-title class=\"v-card-title\">\n                      <v-row class=\"mx-auto pt-0\" dense>\n                        <v-col cols=\"12\">\n                          <div class=\"subhedding text-center white--text\">\n                            {{ stat.user }}\n                          </div>\n                        </v-col>\n                        <v-col cols=\"12\">\n                          <div class=\"grey--text text-center\">\n                            {{ stat.number }}\n                          </div>\n                        </v-col>\n                      </v-row>\n                    </v-card-title>\n                  </v-col>\n                  <v-col cols=\"12\">\n                    <v-card-actions class=\"v-card-action\">\n                      <v-btn color=\"primary\" class=\"mx-auto\">View</v-btn>\n                    </v-card-actions>\n                  </v-col>\n                </v-row>\n              </v-card>\n            </v-hover>\n          </v-col>\n          <v-col cols=\"12\" md=\"2\">\n            <v-date-picker\n              v-model=\"picker\"\n              elevation=\"15\"\n              color=\"orange\"\n              full-width\n              no-title=\"true\"\n              class=\"mt-3\"\n              :landscape=\"$vuetify.breakpoint.smAndUp\"\n            >\n            </v-date-picker>\n          </v-col>\n          <v-col cols=\"12 text-center\" md=\"2\">\n            <v-card shaped>\n              <v-progress-circular\n                :value=\"76\"\n                color=\"pink lighten-4\"\n                size=\"150\"\n                width=\"15\"\n              >\n                76%\n              </v-progress-circular>\n              <h1 class=\"headline\">$5687.87</h1>\n              <h6 class=\"grey-text pl5\">with 25 days</h6>\n            </v-card>\n          </v-col>\n          <v-col cols=\"12\" md=\"6\">\n            <v-card shaped>\n              <h1 class=\"grey--text text-center ma-5\">Result Analysis</h1>\n              <v-sparkline\n                :value=\"value\"\n                :smooth=\"radius || false\"\n                :padding=\"padding\"\n                :line-width=\"linewidth\"\n                :gradient=\"gradient\"\n                auto-draw\n                show-labels\n              >\n              </v-sparkline>\n            </v-card>\n          </v-col>\n          <v-col cols=\"12\" md=\"2\">\n            <v-card class=\"ma-5 text-center mt-8\" shaped elevation=\"10\">\n              <v-avatar class=\"mt-n7\" size=\"80\">\n                <img src=\"@/assets/student.png/\" alt=\"\" />\n              </v-avatar>\n              <v-card-title class=\"layout justify-center\">\n                Chathura Janadara\n              </v-card-title>\n              <v-card-subtitle class=\"layout justify-center\"\n                >Student</v-card-subtitle\n              >\n              <v-list class=\"mt-n5\">\n                <v-list-item>\n                  <v-list-item-title class=\"cyan--text text--darken-1\"\n                    >Blood</v-list-item-title\n                  >\n                  <v-list-item-title class=\"cyan--text text--darken-1\"\n                    >Blood</v-list-item-title\n                  >\n                  <v-list-item-title class=\"cyan--text text--darken-1\"\n                    >Blood</v-list-item-title\n                  >\n                  <v-list-item-title class=\"cyan--text text--darken-1\"\n                    >Blood</v-list-item-title\n                  >\n                </v-list-item>\n              </v-list>\n            </v-card>\n          </v-col>\n\n          <v-col cols=\"12\" md=\"4\">\n            <v-card>\n              <v-card-title><h2 class=\"grey--text\">Notice Board</h2> </v-card-title>\n              <v-virtual-scroll\n                :items=\"noticeBoardData\"\n                :item-height=\"120\"\n                height=\"500\"\n              >\n                <template v-slot:default=\"{ item }\">\n                  <v-card rounded=\"lg\" class=\"ma-2\" flat>\n                    <v-card-title>\n                      <v-chip :color=\"randomColour()\">{{\n                        item.date\n                      }}</v-chip></v-card-title\n                    >\n                    <v-card-subtitle class=\"\">\n                      <h2 class=\"black--text lighten-2\">{{ item.message }}</h2>\n                      <v-spacer />\n                      <h4 class=\"gey--text\">{{ item.author }}</h4>\n                    </v-card-subtitle>\n\n                    <v-spacer></v-spacer>\n                  </v-card>\n                  <v-divider></v-divider>\n                </template>\n                \n\n                <v-spacer></v-spacer>\n              </v-virtual-scroll>\n            </v-card>\n          </v-col>\n        </v-row>\n      </v-container>\n    </div>\n  </v-app>\n</template>\n\n<script>\nconst gradients = [\n  [\"#222\"],\n  [\"#42b3f4\"],\n  [\"red\", \"orange\", \"yellow\"],\n  [\"purple\", \"violet\"],\n  [\"#00c6ff\", \"#F0F\", \"#FF0\"],\n  [\"#f72047\", \"#ffd200\", \"#1feaea\"],\n];\nexport default {\n  data() {\n    return {\n      colorCache: {},\n      width: 2,\n      radius: 10,\n      padding: 8,\n      lineCap: \"round\",\n      gradient: gradients[5],\n      value: [5, 2, 5, 9, 5, 10, 3, 5, 0, 0, 1, 8, 2, 9, 0],\n      gradientDirection: \"top\",\n      gradients,\n      fill: false,\n      type: \"trend\",\n      autoLineWidth: false,\n      arrayEvents: null,\n      date2: new Date().toISOString().substr(0, 10),\n      //picker: new Date.toISOString().substr(0, 10),\n      stats: [\n        {\n          user: \"Students\",\n          number: \"59\",\n          avatar: require(\"../assets/student.png\"),\n        },\n        {\n          user: \"Lecturers\",\n          number: \"59\",\n          avatar: require(\"../assets/presentation.png\"),\n        },\n        {\n          user: \"Modules\",\n          number: \"22\",\n          avatar: require(\"../assets/online-course.png\"),\n        },\n        {\n          user: \"Topics\",\n          number: \"89\",\n          avatar: require(\"../assets/checklist.png\"),\n        },\n      ],\n      noticeBoardData: [\n        {\n          date: \"16 June 2021\",\n          message: \"Batch trip was postponed by the VC\",\n          author: \"Rep\",\n        },\n        {\n          date: \"25 June 2021\",\n          message: \"Batch trip was postponed by the VC\",\n          author: \"Rep\",\n        },\n        {\n          date: \"03 july 2021\",\n          message: \"Batch trip was postponed by the VC\",\n          author: \"Rep\",\n        },\n        {\n          date: \"18 july 2021\",\n          message: \"Batch trip was postponed by the VC\",\n          author: \"Rep\",\n        },\n        {\n          date: \"19 july 2021\",\n          message: \"Batch trip was postponed by the VC\",\n          author: \"Rep\",\n        },\n        {\n          date: \"20 july 2021\",\n          message: \"Batch trip was postponed by the VC\",\n          author: \"Rep\",\n        },\n        {\n          date: \"18 july 2021\",\n          message: \"Batch trip was postponed by the VC\",\n          author: \"Rep\",\n        },\n        {\n          date: \"21 july 2021\",\n          message: \"Batch trip was postponed by the VC\",\n          author: \"Rep\",\n        },\n        {\n          date: \"22 july 2021\",\n          message: \"Batch trip was postponed by the VC\",\n          author: \"Rep\",\n        },\n        {\n          date: \"23 july 2021\",\n          message: \"Batch trip was postponed by the VC\",\n          author: \"Rep\",\n        },\n      ],\n      date: [\n        \"16 June 2021\",\n        \"17 June 2021\",\n        \"18 June 2021\",\n        \"19 June 2021\",\n        \"20 June 2021\",\n        \"21 June 2021\",\n      ],\n      message: [\n        \"Batch trip was postponed by the VC\",\n        \"Batch trip was postponed by the VC\",\n\n        \"Batch trip was postponed by the VC\",\n\n        \"Batch trip was postponed by the VC\",\n\n        \"Batch trip was postponed by the VC\",\n\n        \"Batch trip was postponed by the VC\",\n      ],\n      colors: [\n        \"#E91E63\",\n        \"#9C27B0\",\n        \"#F44336\",\n        \"#2196F3\",\n        \"#FFEB3B\",\n        \"#795548\",\n        \"#00C853\",\n        \"#64DD17\",\n        \"#18FFFF\",\n        \"#7C4DFF\",\n        \"#FDD835\",\n        \"#2962FF\",\n      ],\n      // author: [\"rep\", \"rep\", \"rep\", \"rep\", \"rep\", \"rep\"],\n    };\n  },\n  // computed:{\n  //   itemss(){\n  //     const colorsLength = this.colors.length\n  //     const messageLength =this.message.length\n  //     const authorLength=this.author.length\n\n  //     return {\n\n  //           color: this.colors[this.genRandomIndex(colorsLength)],\n  //           message:this.message[this.genRandomIndex(messageLength)],\n  //           author:this.authorLength[this.genRandomIndex(authorLength)],\n\n  //         }\n  //   }\n  // },\n\n  components: {},\n  methods: {\n    randomColour() {\n      // const r=()=>Math.floor(256*Math.random());\n      return this.colors[this.genRandomIndex(this.colors.length)];\n    },\n    genRandomIndex(length) {\n      return Math.ceil(Math.random() * (length - 1));\n    },\n  },\n};\n</script>\n\n<style>\n.avatar {\n  margin-top: -55px;\n  text-align: center;\n}\n.v-card-title {\n  margin-top: -30px;\n}\n.v-card-action {\n  margin-top: -35px;\n}\n.backgroundcolor {\n  background-color: lightblue;\n}\n</style>"],"sourceRoot":"src/components"}]}
uted:{\n    noticeBoardData(){\n      return this.$store.state.noticeBoardData\n    },\n    colors(){\n      return this.$store.state.colors;\n    },\n    backColors(){\n      return this.$store.state.backColors\n    }\n  }\n};\n</script>\n\n<style>\n</style>"],"sourceRoot":"src/components/Widgets"}]}